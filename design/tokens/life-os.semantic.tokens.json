      },
      "strong": {
        "$type": "color",
        "$value": "{Primitives.color.neutral.300}",
        "$description": "Hovered card border"
      }
    },
    "accent": {
      "solid": {
        "$type": "color",
        "$value": "{Primitives.color.brand.500}",
        "$description": "Rail icons, selected markers, active states"
      },
      "soft": {
        "$type": "color",
        "$value": "{Primitives.color.brand.200}",
        "$description": "Rail background"
      },
      "subtle": {
        "$type": "color",
        "$value": "{Primitives.color.brand.100}",
        "$description": "Selected tag background"
      },
      "text": {
        "$type": "color",
        "$value": "{Primitives.color.brand.800}",
        "$description": "Accent text and the active rail icon"
