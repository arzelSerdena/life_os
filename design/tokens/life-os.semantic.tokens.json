    "neutral": {
      "solid": {
        "$type": "color",
        "$value": "{Primitives.color.neutral.500}",
        "$description": "No-area items: dots, checkboxes, progress fill (neutral 500)"
      },
      "done": {
        "$type": "color",
        "$value": "{Primitives.color.neutral.200}",
        "$description": "No-area items: checked checkbox fill (neutral 200)"
      },
      "tint-active": {
        "$type": "color",
        "$value": "{Primitives.color.neutral.100}",
        "$description": "No-area items: upcoming event background, pill (neutral 100)"
      },
      "text": {
        "$type": "color",
        "$value": "{Primitives.color.neutral.900}",
        "$description": "No-area items: text on white (neutral 900)"
      },
      "ink": {
        "$type": "color",
        "$value": "{Primitives.color.neutral.950}",
        "$description": "No-area items: text on a neutral tint (neutral 950)"
      },
      "border": {
        "$type": "color",
        "$value": "{Primitives.color.neutral.300}",
        "$description": "No-area items: borders (neutral 300)"
      },
      "tint-past": {
        "$type": "color",
        "$value": "{Primitives.color.neutral.50}",
        "$description": "No-area items: past event background (neutral 50)"
      }
    }
