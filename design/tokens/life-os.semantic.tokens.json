      "text": {
        "$type": "color",
        "$value": "{Primitives.color.area.blue.900}",
        "$description": "STAND-IN (code: area 900). Area-colored text on white"
      },
      "ink": {
        "$type": "color",
        "$value": "{Primitives.color.area.blue.950}",
