{
  "Semantic": {
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{Primitives.color.neutral.900}",
        "$description": "Titles and main text"
      },
      "secondary": {
        "$type": "color",
        "$value": "{Primitives.color.neutral.600}",
        "$description": "Body, subtasks, sidebar items"
      },
      "tertiary": {
        "$type": "color",
        "$value": "{Primitives.color.neutral.500}",
        "$description": "Metadata; lightest color allowed for readable text"
      },
      "disabled": {
        "$type": "color",
        "$value": "{Primitives.color.neutral.400}",
        "$description": "Completed / cancelled items only"
      },
      "on-accent": {
        "$type": "color",
        "$value": "{Primitives.color.white}",
        "$description": "Text on accent fills"
      },
      "danger": {
        "$type": "color",
        "$value": "{Primitives.color.negative.600}",
        "$description": "Overdue dates, destructive actions"
      }
    },
    "bg": {
      "app": {
        "$type": "color",
        "$value": "{Primitives.color.white}",
        "$description": "Main frame"
      },
      "surface": {
        "$type": "color",
        "$value": "{Primitives.color.white}",
        "$description": "Cards, panels, sidebar"
      },
      "hover": {
        "$type": "color",
        "$value": "{Primitives.color.neutral.100}",
        "$description": "Hover on white surfaces"
      },
      "pressed": {
        "$type": "color",
        "$value": "{Primitives.color.neutral.200}",
        "$description": "Pressed / hover on grey"
      }
    },
    "border": {
      "default": {
        "$type": "color",
        "$value": "{Primitives.color.neutral.200}",
