      "border": {
        "$type": "color",
        "$value": "{Primitives.color.area.blue.300}",
        "$description": "STAND-IN (code: area 300). Area-colored borders"
      },
      "done": {
        "$type": "color",
        "$value": "{Primitives.color.area.blue.200}",
        "$description": "STAND-IN (code: area 200). Checked checkbox fill"
      },
      "tint-past": {
        "$type": "color",
        "$value": "{Primitives.color.area.blue.50}",
        "$description": "STAND-IN (code: area 50). Past event background"
      }
