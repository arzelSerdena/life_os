    "icon": {
      "tertiary": {
        "$type": "color",
        "$value": "{Primitives.color.neutral.500}",
        "$description": "Metadata icons on cards"
      },
      "white": {
        "$type": "color",
        "$value": "{Primitives.color.white}",
        "$description": "Icons on solid fills"
      },
      "primary": {
        "$type": "color",
        "$value": "{Primitives.color.neutral.700}",
        "$description": "Default UI icons"
      }
